# Copy to backend/.env and fill in. Real values never go into git.

# --- AI -----------------------------------------------------------------------------
# anthropic (Claude API) | openai (OpenAI API) | gemini (Google Gemini API)
# | openai_compatible (Ollama, vLLM, Azure OpenAI...) | mock (offline demo)
MF_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MF_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
MF_ANTHROPIC_EFFORT=high

# Used when MF_LLM_PROVIDER=openai (no default model: set a current one)
OPENAI_API_KEY=
MF_OPENAI_NATIVE_MODEL=

# Used when MF_LLM_PROVIDER=gemini (no default model: set a current one)
GEMINI_API_KEY=
MF_GEMINI_MODEL=

# Used when MF_LLM_PROVIDER=openai_compatible
MF_OPENAI_BASE_URL=http://localhost:11434/v1
MF_OPENAI_MODEL=llama3.3:70b
MF_OPENAI_API_KEY=

# --- Supplier connectors (each is enabled only when its keys are set) -----------------
MOUSER_API_KEY=
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
MF_OFFER_CACHE_HOURS=24

# --- Sourcing ---------------------------------------------------------------------------
MF_BASE_CURRENCY=EUR
# 1 unit of currency = rate units of the base currency (approximate; update them)
MF_FX_RATES=USD=0.92,GBP=1.17,CHF=1.06,JPY=0.0061,CNY=0.13
MF_WEIGHT_PRICE=0.5
MF_WEIGHT_LEAD_TIME=0.3
MF_WEIGHT_AVAILABILITY=0.2

# --- Server -----------------------------------------------------------------------------
# MF_DB_PATH=data/machine-forge.db
MF_CORS_ORIGINS=http://localhost:5173

# --- Project JSON import ----------------------------------------------------------------
MF_MAX_IMPORT_MB=20
